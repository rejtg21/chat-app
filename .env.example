# ── Database ──────────────────────────────────────────────────────────────
# Neon Postgres with the pgvector extension enabled.
# Use the POOLED connection string (the host contains "-pooler") — these
# routes run on the Node runtime with a real connection pool.
#
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# A local Postgres works too, which is how the pipeline is tested:
#   docker run -d --name docdesk-pg -e POSTGRES_PASSWORD=docdesk \
#     -e POSTGRES_DB=docdesk -p 55432:5432 pgvector/pgvector:pg16
#   postgresql://postgres:docdesk@localhost:55432/docdesk
DATABASE_URL=

# ── Model access ──────────────────────────────────────────────────────────
# Vercel AI Gateway key. One key reaches every provider, and models are named
# as plain "provider/model" strings.
#   https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai
#
# Not needed locally when running `vercel dev` on a linked project: the OIDC
# token in .env.local (from `vercel env pull`) authenticates instead.
AI_GATEWAY_API_KEY=

# ── Optional model overrides ──────────────────────────────────────────────
# Defaults live in src/lib/config.ts. CHAT_MODEL writes the answer;
# ANNOTATION_MODEL picks the structured component afterwards.
# CHAT_MODEL=anthropic/claude-sonnet-5
# ANNOTATION_MODEL=anthropic/claude-haiku-4.5

# Embeddings are free and local (Supabase/gte-small via Transformers.js,
# 384-d). There is no key to set. Changing the model means changing
# EMBEDDING_DIMENSIONS in src/lib/config.ts AND the vector(384) column in
# db/migrations/0001_init.sql, then re-indexing.
